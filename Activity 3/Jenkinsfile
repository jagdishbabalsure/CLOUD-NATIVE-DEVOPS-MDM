pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Activity 3') {
                    sh 'npm ci'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('Activity 3') {
                    sh 'npm test'
                }
            }
        }

        stage('Build Application') {
            steps {
                dir('Activity 3') {
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Activity 3') {
                    sh 'docker build -t taskflow-app:latest .'
                }
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                    docker rm -f taskflow-app 2>/dev/null || true
                    docker run -d --name taskflow-app -p 8082:80 taskflow-app:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: TaskFlow built and deployed!'
        }
        failure {
            echo 'FAILED: Check the Jenkins Console Output.'
        }
    }
}
