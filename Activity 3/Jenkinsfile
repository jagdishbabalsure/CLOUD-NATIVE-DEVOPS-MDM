pipeline {
    agent any

    environment {
        APP_NAME = "taskflow-dashboard"
        DOCKER_IMAGE = "taskflow-app"
        CONTAINER_PORT = "80"
        HOST_PORT = "8085"
        REGISTRY_TAG = "${env.BUILD_NUMBER}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout SCM') {
            steps {
                echo "========================================="
                echo "Stage 1: Checking out Source Code from Git"
                echo "========================================="
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "========================================="
                echo "Stage 2: Installing Node.js Dependencies"
                echo "========================================="
                // If the Activity 3 code is in a subdirectory, navigate into it or execute directly
                dir('Activity 3') {
                    sh 'node -v'
                    sh 'npm -v'
                    sh 'npm ci || npm install'
                }
            }
        }

        stage('Code Linting') {
            steps {
                echo "========================================="
                echo "Stage 3: Running Static Code Analysis"
                echo "========================================="
                dir('Activity 3') {
                    sh 'npm run lint || true'
                }
            }
        }

        stage('Automated Unit Testing') {
            steps {
                echo "========================================="
                echo "Stage 4: Running Unit Tests with Vitest"
                echo "========================================="
                dir('Activity 3') {
                    sh 'npm test'
                }
            }
        }

        stage('Build Production Bundle') {
            steps {
                echo "========================================="
                echo "Stage 5: Compiling Production Build"
                echo "========================================="
                dir('Activity 3') {
                    sh 'npm run build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "========================================="
                echo "Stage 6: Building Docker Container Image"
                echo "========================================="
                dir('Activity 3') {
                    sh "docker build -t ${DOCKER_IMAGE}:${REGISTRY_TAG} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Container Deployment') {
            steps {
                echo "========================================="
                echo "Stage 7: Deploying Containerized Application"
                echo "========================================="
                sh """
                    # Stop and remove existing container if running
                    docker stop ${APP_NAME} || true
                    docker rm ${APP_NAME} || true

                    # Run new container
                    docker run -d \
                        --name ${APP_NAME} \
                        --restart unless-stopped \
                        -p ${HOST_PORT}:${CONTAINER_PORT} \
                        ${DOCKER_IMAGE}:${REGISTRY_TAG}
                """
            }
        }

        stage('Health & Smoke Verification') {
            steps {
                echo "========================================="
                echo "Stage 8: Verifying Application Health"
                echo "========================================="
                sleep 5
                sh """
                    # Verify HTTP response from deployed container
                    curl --fail --retry 3 --retry-delay 5 http://localhost:${HOST_PORT}/ || exit 1
                    echo "Application is live and responding on port ${HOST_PORT}!"
                """
            }
        }
    }

    post {
        always {
            echo "========================================="
            echo "Pipeline Run Finished for Build #${BUILD_NUMBER}"
            echo "========================================="
        }
        success {
            echo "SUCCESS: CI/CD Pipeline completed successfully. TaskFlow is deployed!"
        }
        failure {
            echo "FAILURE: The build or deployment failed. Please inspect console logs."
        }
    }
}
