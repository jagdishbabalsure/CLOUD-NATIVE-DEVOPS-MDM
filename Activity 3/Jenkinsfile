pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Activity 3') {
                    sh 'npm ci'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('Activity 3') {
                    sh 'npm test'
                }
            }
        }

        stage('Build Application') {
            steps {
                dir('Activity 3') {
                    sh 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: TaskFlow built successfully!'
        }
        failure {
            echo 'FAILED: Check the Jenkins console output.'
        }
    }
}
